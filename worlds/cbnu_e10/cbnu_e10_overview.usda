#usda 1.0
(
    customLayerData = {
        string purpose = "Inspection only; ceiling collision remains active. Use cbnu_e10.usda for simulation."
    }
    subLayers = [
        @cbnu_e10.usda@
    ]
)

over "World"
{
    over "Ceilings"
    {
        token visibility = "invisible"
    }

    over "Exterior"
    {
        token visibility = "invisible"
    }
}

