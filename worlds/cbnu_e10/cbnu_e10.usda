    def Xform "Looks"
    {
        def Material "Wall" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.79, 0.8, 0.76)
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }

        def Material "Ceiling" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
