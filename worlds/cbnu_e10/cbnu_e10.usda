#usda 1.0
(
    customLayerData = {
        string config_sha256 = "104eb57915f4d2534e52621729c854c5cfc191d094df11daf034db06da95e060"
        string generator = "scripts/build_world.py"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    custom double e10:corridor_clear_height = 2.5
    custom double e10:corridor_clear_width = 2.1
    custom string e10:sourceVideo = "/home/a/Downloads/CBNU-E10.mp4"
    custom double e10:stair_flight_width = 1.5
    custom double e10:stair_riser = 0.16
    custom int e10:surveyedFloor = 3

    def Xform "Looks"
    {
        def Material "Wall" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.79, 0.8, 0.76)
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }

        def Material "Ceiling" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Ceiling/Surface.outputs:surface>
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.83, 0.79)
                color3f inputs:diffuseColor.connect = </World/Looks/Ceiling/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../assets/textures/ceiling.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Ceiling/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

