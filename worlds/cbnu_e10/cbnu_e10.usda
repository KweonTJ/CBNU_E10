    def Xform "SpawnPoints"
    {
        def Xform "CorridorStart"
        {
            custom double e10:robotBaseHeight = 0.55
            double3 xformOp:translate = (4.4, 0, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "CorridorReturn"
        {
            custom double e10:robotBaseHeight = 0.55
            float xformOp:rotateZ = 180
            double3 xformOp:translate = (31, 0, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "StartStairApproach"
        {
            custom double e10:robotBaseHeight = 0.55
            float xformOp:rotateZ = -90
            double3 xformOp:translate = (3.24, -1.65, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "FarStairApproach"
        {
            custom double e10:robotBaseHeight = 0.55
            float xformOp:rotateZ = 90
            double3 xformOp:translate = (35.16, 1.65, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom bool physxScene:enableGPUDynamics = 0
        custom uint physxScene:timeStepsPerSecond = 120
    }
